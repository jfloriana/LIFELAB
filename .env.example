# ── Servidor ──
PORT=3001

# ⚠️ CAMBIA ESTA CLAVE por una segura (usar: openssl rand -base64 48)
JWT_SECRET=cambia_esto_por_una_clave_segura_de_al_menos_32_caracteres

# ── Base de Datos PostgreSQL (Supabase / Neon / Railway) ──
# Formato: postgresql://usuario:password@host:puerto/base
DATABASE_URL=postgresql://usuario:password@localhost:5432/clinica

# ── URLs ──
PUBLIC_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── SMTP (Gmail / SendGrid / Mailgun) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password

# ── Seguridad ──
# Opción 1 (recomendada para producción): usa el certificado CA de Supabase
# Descárgalo desde: Supabase Dashboard → Database → Settings → SSL Configuration
# Luego descomenta esta línea:
# DB_SSL_CA_PATH=./prod-ca-2021.crt
#
# Opción 2 (solo desarrollo): deshabilita la verificación SSL
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── Entorno ──
# NODE_ENV=production
